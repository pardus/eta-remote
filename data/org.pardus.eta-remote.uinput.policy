<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/polkit-config.dtd">
<policyconfig>

  <action id="org.pardus.eta_remote.uinput">
    <description>Run the eta-remote uinput control worker without prompting</description>
    <message>Authentication is required to run the eta-remote uinput worker</message>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/python3</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">/usr/share/eta/eta-remote/client/actions.py</annotate>
  </action>

</policyconfig>
