#include <Python.h>

int main(int argc, char *argv[]) {
    PyStatus status;
    PyConfig config;
    PyConfig_InitPythonConfig(&config);

    /* Ignore environment variables like PYTHONPATH, PYTHONHOME, etc. */
    config.use_environment = 0;
    /* Do not add user site directory (~/.local/lib/...) */
    config.user_site_directory = 0;
    /* Do not parse python args */
    config.parse_argv = 0; 

    status = PyConfig_SetBytesArgv(&config, argc, argv);
    if (PyStatus_Exception(status)) {
        PyConfig_Clear(&config);
        return 1;
    }

    status = Py_InitializeFromConfig(&config);
    if (PyStatus_Exception(status)) {
        PyConfig_Clear(&config);
        return 1;
    }

    const char *python_code =
        "import sys\n"
        "prefix = '@PREFIX@'\n"
        "sys.path.insert(0, prefix + '/share/eta/eta-remote')\n"
        "\n"
        "from Main import Application\n"
        "\n"
        "app = Application()\n"
        "print(sys.argv)\n"
        "app.run(sys.argv)\n";

    int result = PyRun_SimpleString(python_code);
    PyConfig_Clear(&config);
    Py_Finalize();
    return result;
}
