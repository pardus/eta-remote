#include <Python.h>

int main(int argc, char *argv[]) {
#if PY_VERSION_HEX >= 0x03080000
    PyStatus status;
    PyConfig config;
    PyConfig_InitPythonConfig(&config);

    /* Ignore environment variables like PYTHONPATH, PYTHONHOME, etc. */
    config.use_environment = 0;
    /* Do not add user site directory (~/.local/lib/...) */
    config.user_site_directory = 0;

    status = PyConfig_SetBytesArgv(&config, argc, argv);
    if (PyStatus_Exception(status)) {
        PyConfig_Clear(&config);
        return 1;
    }

    status = Py_InitializeFromConfig(&config);
    PyConfig_Clear(&config);
    if (PyStatus_Exception(status)) {
        return 1;
    }
#else
    Py_IgnoreEnvironmentFlag = 1;
    Py_NoUserSiteDirectory = 1;
    Py_Initialize();

    #if PY_MAJOR_VERSION >= 3
        wchar_t **wargv = (wchar_t **)malloc(sizeof(wchar_t *) * argc);
        for (int i = 0; i < argc; i++) {
            wargv[i] = Py_DecodeLocale(argv[i], NULL);
        }
        PySys_SetArgv(argc, wargv);
    #else
        PySys_SetArgv(argc, argv);
    #endif
#endif

    const char *python_code =
        "import sys\n"
        "prefix = '@PREFIX@'\n"
        "sys.path.insert(0, prefix + '/share/eta/eta-remote')\n"
        "\n"
        "from Main import Application\n"
        "\n"
        "app = Application()\n"
        "app.run(sys.argv)\n";

    int result = PyRun_SimpleString(python_code);

#if PY_VERSION_HEX < 0x03080000
    #if PY_MAJOR_VERSION >= 3
        for (int i = 0; i < argc; i++) {
            PyMem_RawFree(wargv[i]);
        }
        free(wargv);
    #endif
#endif

    Py_Finalize();
    return result;
}
